# ============================================================
# LeadGenAI Python Backend — Environment Variables
# ============================================================
# Copy to .env and fill in your values.
# All provider keys have deterministic mock fallbacks — the
# server runs without them (mock mode).
# SUPABASE is the only hard requirement for auth to work.

# ---- AI Provider ----
ANTHROPIC_API_KEY=           # Claude Sonnet 4.5; mock if unset

# ---- Discovery ----
BRAVE_SEARCH_KEY=            # Brave Search API; DuckDuckGo mock if unset
GITHUB_TOKEN=                # GitHub Personal Access Token; public rate-limited if unset
PRODUCTHUNT_TOKEN=           # ProductHunt API; mock makers if unset

# ---- Supabase (REQUIRED for auth) ----
NEXT_PUBLIC_SUPABASE_URL=    # e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # SERVER-ONLY. Never expose to browser.

# ---- Google (Sheets export + Gmail OAuth) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Billing ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


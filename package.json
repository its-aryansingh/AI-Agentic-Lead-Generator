  "packageManager": "npm@10.9.7",
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_OPTIONS=--max_old_space_size=4096 next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test --experimental-strip-types tests/*.test.ts tests/evals/*.test.ts",
    "db:push": "supabase db push",
    "db:bundle": "node scripts/bundle-schema.mjs",
    "test:integration": "node --import tsx --test tests/integration/*.test.ts",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/migrations/0001_enrichment_runs.sql",
    "verify:openai": "node scripts/verify-openai.mjs"
  },

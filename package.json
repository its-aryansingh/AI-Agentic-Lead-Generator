    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "ai": "^6.0.277",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "googleapis": "^171.4.0",
    "inngest": "^4.20.0",
    "libphonenumber-js": "^1.13.12",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "openai": "^7.10.0",
    "pg": "^8.13.1",
    "razorpay": "^2.9.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
